# Database Configuration
DB_DRIVER=sqlite3
DB_DSN=./s3scanner.db

# Scanner Configuration
ENABLE_OTX=true
ENABLE_IOC=true
ENABLE_YARA=true
IOC_PATH=rules/ioc/
YARA_PATH=rules/yara/
YARA_CMD=yara
OTX_API_KEY=your-otx-api-key

# S3 Configuration
S3_BUCKET=your-bucket-name
S3_PREFIX=
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com
# Ignored by MinIO and most S3-compatible servers, but the request signer needs
# one. Defaults to us-east-1.
S3_REGION=us-east-1

# Reporter Configuration
# Reporter types: json, elasticsearch, loki, prometheus
REPORTER_TYPE=json
REPORTER_PATH=./scan-results.json

# Elasticsearch Configuration (if using elasticsearch reporter)
ES_URL=http://localhost:9200
ES_INDEX=s3-scan-results

# Loki Configuration (if using loki reporter)
LOKI_URL=http://localhost:3100

# Prometheus Configuration (if using prometheus reporter)
PROMETHEUS_URL=http://localhost:9090

# --- Staged pipeline ---
# Each stage is bounded by the resource it actually contends for, so these are
# deliberately not one number.

# Total bytes the pipeline may hold at once. Held from the start of a transfer
# until the payload is deleted after scanning, so it covers both network buffers
# and temp files on disk — not just the download.
#
# Bytes rather than a file count: a file count cannot tell 10,000 small objects
# from one huge one. This is also the global brake — when everything downstream
# stalls, fetch runs out of budget and stops pulling.
FETCH_BYTE_BUDGET=512MB
# Concurrent transfers, regardless of their size.
FETCH_MAX_CONNS=16
# Skip objects larger than this. 0 disables.
MAX_OBJECT_SIZE=1GB

# Concurrent scanning. 0 means GOMAXPROCS, which is the right answer for
# CPU-bound work.
ANALYZE_CPU_LIMIT=0

# Flush triggers; whichever fires first wins. The interval is measured from the
# first document entering an empty batch, so nothing waits longer than one.
PUBLISH_BATCH_SIZE=100
PUBLISH_FLUSH_INTERVAL=2s
PUBLISH_MAX_BYTES=5MB

# Buffer between stages. Bounded on purpose: a full queue is what makes a slow
# stage push back on a fast one.
STAGE_QUEUE_SIZE=1000

# Serves /metrics and /healthz. Empty disables it.
METRICS_ADDR=:8080

# --- Per-scanner lanes ---
# Which scanners park work instead of blocking when their queue fills. The
# distinction is how long the wait is: CPU saturation clears in seconds, so
# blocking is honest backpressure; an API quota clears in hours, so blocking on
# it lets a third party set the throughput of everything else.
SPILL_SCANNERS=otx,virustotal,sandbox
PENDING_RETRY_BASE=30s
PENDING_MAX_ATTEMPTS=5

# --- VirusTotal ---
# Hash lookup only. There is no upload path, on purpose: what gets scanned is
# somebody's bucket, and uploading its contents would put their documents in
# front of every VirusTotal licensee.
ENABLE_VT=false
VT_API_KEY=
VT_RATE_PER_MIN=4          # free tier
VT_DAILY_QUOTA=500         # stop before the provider cuts you off mid-run
VT_SEVERITY_MEDIUM=3       # 1-2 hits out of ~70 engines is often a false positive
VT_SEVERITY_HIGH=10
OTX_RATE_PER_MIN=600

# How long a third-party verdict is trusted. Cached by content hash, not by
# object: the same payload under twenty keys costs one lookup.
INTEL_CACHE_TTL=168h

# --- Where work comes from ---
# lister paginates the bucket: right for backfills, audits, and storage with no
# notification support. event consumes bucket notifications: right for steady
# state, where detection latency stops being the schedule interval.
SOURCE_MODE=lister

# Only read when SOURCE_MODE=event. The two axes are independent — MinIO
# publishes to either broker — except that the envelope differs per transport,
# which the decoder handles.
EVENT_TRANSPORT=redis      # redis | kafka
EVENT_FORMAT=minio         # only minio is implemented

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_KEY=s3nitor-events   # the list MinIO RPUSHes onto
REDIS_DB=0

KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=s3nitor-events
KAFKA_GROUP_ID=s3nitor
