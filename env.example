# Database Configuration
DB_DRIVER=sqlite3
DB_DSN=./s3scanner.db

# Scanner Configuration
ENABLE_OTX=true
ENABLE_IOC=true
ENABLE_YARA=true
IOC_PATH=rules/ioc/
YARA_PATH=rules/yara/
YARA_CMD=yara
OTX_API_KEY=your-otx-api-key

# S3 Configuration
S3_BUCKET=your-bucket-name
S3_PREFIX=
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_ENDPOINT=https://s3.amazonaws.com

# Worker Configuration
WORKER_COUNT=0

# Reporter Configuration
# Reporter types: json, elasticsearch, loki, prometheus
REPORTER_TYPE=json
REPORTER_PATH=./scan-results.json

# Elasticsearch Configuration (if using elasticsearch reporter)
ES_URL=http://localhost:9200
ES_INDEX=s3-scan-results

# Loki Configuration (if using loki reporter)
LOKI_URL=http://localhost:3100

# Prometheus Configuration (if using prometheus reporter)
PROMETHEUS_URL=http://localhost:9090

# --- Staged pipeline ---
# Each stage is bounded by the resource it actually contends for, so these are
# deliberately not one number.

# Total bytes in flight across the fetch stage. Bytes rather than a file count:
# a file count cannot tell 10,000 small objects from one huge one.
FETCH_BYTE_BUDGET=512MB
# Concurrent transfers, regardless of their size.
FETCH_MAX_CONNS=16
# Skip objects larger than this. 0 disables.
MAX_OBJECT_SIZE=1GB

# Concurrent scanning. 0 means GOMAXPROCS, which is the right answer for
# CPU-bound work.
ANALYZE_CPU_LIMIT=0

# Flush triggers; whichever fires first wins. The interval is measured from the
# first document entering an empty batch, so nothing waits longer than one.
PUBLISH_BATCH_SIZE=100
PUBLISH_FLUSH_INTERVAL=2s
PUBLISH_MAX_BYTES=5MB

# Buffer between stages. Bounded on purpose: a full queue is what makes a slow
# stage push back on a fast one.
STAGE_QUEUE_SIZE=1000

# Serves /metrics and /healthz. Empty disables it.
METRICS_ADDR=:8080
